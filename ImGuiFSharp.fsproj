<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ImGuiFSharp</RootNamespace>
    <AssemblyName>ImGuiFSharp</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Version>1.1.0</Version>
    <RepositoryUrl>https://github.com/thefirstsparkproject/ImGuiFSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile order matters in F# -->
    <Compile Include="ImGuiNodeEditorInternal.fs" />
    <Compile Include="IGuiFunctions.fs" />
    <Compile Include="ImGuiInternal.fs" />
    <Compile Include="ImGuiNodeEditorInstance.fs" />
    <Compile Include="ImGuiInstance.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="runtimes/win-x64/native/ImGuiNative.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="runtimes/linux-x64/native/libImGuiNative.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="runtimes/osx-x64/native/libImGuiNative.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="runtimes/osx-arm64/native/libImGuiNative.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>
</Project>
